{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#50fa7b",
          "style": "plain",
          "template": " {{ reason .Code }}",
          "type": "status"
        },
        {
          "foreground": "#ff79c6",
          "style": "plain",
          "template": " \uf0e7 ",
          "type": "root"
        },
        {
          "foreground": "#f8f8f2",
          "style": "plain",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "#44475a",
          "foreground": "#f8f8f2",
          "properties": {
            "folder_icon": "\uf115",
            "folder_separator_icon": " \ue0b1 ",
            "style": "full"
          },
          "style": "plain",
          "template": "<transparent>\ue0b0</> {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#bd93f9",
          "foreground": "#282a36",
          "style": "plain",
          "template": "<#282a36>\ue0b1</> {{ .HEAD }} ",
          "type": "git"
        },
        {
          "foreground": "#f8f8f2",
          "style": "plain",
          "template": "\ue0b0 ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 3
}
