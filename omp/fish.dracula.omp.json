{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": " {{ reason .Code }}",
          "foreground": "#ff5555",
          "type": "status",
          "style": "plain"
        },
        {
          "template": " \uf0e7 ",
          "foreground": "#ff79c6",
          "type": "root",
          "style": "plain"
        },
        {
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "#f8f8f2",
          "type": "session",
          "style": "plain"
        },
        {
          "options": {
            "folder_icon": "\uf115",
            "folder_separator_icon": " \ue0b1 ",
            "style": "full"
          },
          "template": "<transparent>\ue0b0</> {{ .Path }} ",
          "foreground": "#282a36",
          "background": "#bd93f9",
          "type": "path",
          "style": "plain"
        },
        {
          "template": "<#282a36>\ue0b1</> {{ .HEAD }} ",
          "foreground": "#282a36",
          "background": "#bd93f9",
          "type": "git",
          "style": "plain"
        },
        {
          "template": "\ue0b0 ",
          "foreground": "#bd93f9",
          "type": "text",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 4
}
