[core]
	excludesfile = ~/.config/git/ignore
	autocrlf = input
	editor = code --wait

[color]
	ui = auto

[commit]
	gpgsign = true
	verbose = true

[rebase]
	updateRefs = true
	autosquash = true

[push]
	default = current

[pull]
	rebase = true

[merge]
	renameLimit = 999999

[pack]
	useSparse = true

[alias]
	co = checkout
	st = status
